{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "音乐播放器主模块",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,  // 👈 修复报错 1：必须配置是否随应用安装分发
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "主程序入口",
        "exported": true,
        "startWindowIcon": "$media:layered_image",       // 👈 修复报错 2：必须配置启动图标
        "startWindowBackground": "$color:start_window_background", // 👈 修复报错 3：必须配置启动背景色
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          }
        ]
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      }
    ]
  }
}